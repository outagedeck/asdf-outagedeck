#!/usr/bin/env bash

set -euo pipefail

plugin_dir="$(dirname "$(dirname "${BASH_SOURCE[0]}")")"
# shellcheck source=/dev/null
source "$plugin_dir/lib/utils.bash"

mkdir -p "$ASDF_DOWNLOAD_PATH"
archive="$ASDF_DOWNLOAD_PATH/outagedeck-$ASDF_INSTALL_VERSION.tar.gz"

download_release "$ASDF_INSTALL_VERSION" "$archive"
tar -xzf "$archive" -C "$ASDF_DOWNLOAD_PATH" || fail "could not extract $archive"
rm -f "$archive"
